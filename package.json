{
  "name": "pi-extensions",
  "version": "0.0.0",
  "private": true,
  "description": "Private meta package for Pi extension authoring resources.",
  "scripts": {
    "agents:generate": "node --experimental-strip-types scripts/agents-schema.ts --write",
    "agents:check": "node --experimental-strip-types scripts/agents-schema.ts AGENTS.yml template/AGENTS.yml",
    "check": "npm run agents:check"
  },
  "keywords": [
    "pi-package"
  ],
  "files": [
    "skills",
    "template",
    "copier.yml",
    "README.md"
  ],
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "pi-context-preload": "file:./pi-context-preload",
    "pi-modes": "file:./pi-modes",
    "pi-prompts": "file:./pi-prompts",
    "typebox": "1.3.30",
    "yaml": "2.9.0"
  }
}
