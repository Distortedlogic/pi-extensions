{
  "name": "pi-extensions",
  "version": "0.0.0",
  "private": true,
  "description": "Private meta package for Pi extension authoring resources.",
  "scripts": {
    "agents:generate": "node --experimental-strip-types scripts/agents-schema.ts --write",
    "agents:check": "node --experimental-strip-types scripts/agents-schema.ts AGENTS.yml template/AGENTS.yml",
    "check": "npm run agents:check"
  },
  "keywords": [
    "pi-package"
  ],
  "files": [
    "skills",
    "template",
    "copier.yml",
    "README.md"
  ],
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "pi-context-preload": "git+https://github.com/Distortedlogic/pi-context-preload.git#ee8ee99f2ff4a1437d92683d7fae600ce0467126",
    "pi-modes": "git+https://github.com/Distortedlogic/pi-modes.git#e66386336e22c3efb2034944e86adaf2556ac23c",
    "pi-prompts": "git+https://github.com/Distortedlogic/pi-prompts.git#45e681673240c9de0a2e49f86c0b5ea0b43d7c99",
    "typebox": "1.3.30",
    "yaml": "2.9.0"
  }
}
