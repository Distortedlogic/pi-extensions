{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://distortedlogic.net/schemas/context-preload.schema.json",
	"title": "Pi context preload configuration",
	"type": "object",
	"additionalProperties": true,
	"properties": {
		"preload": {
			"$ref": "#/$defs/preload"
		}
	},
	"$defs": {
		"preload": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"extends": {
					"$ref": "#/$defs/stringList"
				},
				"files": {
					"$ref": "#/$defs/stringList"
				},
				"contexts": {
					"$ref": "#/$defs/stringList"
				}
			}
		},
		"stringList": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			}
		}
	}
}
