{% set pi_version = "1.1.0" -%}
{% set typebox_version = "1.3.34" -%}
{
	"name": "{{ project_name }}",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"keywords": [
		"pi-package"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Distortedlogic/{{ project_name }}.git"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"check": "npm run typecheck && npm run lint && npm test",
		"format": "biome check --write .",
		"lint": "biome check .",
		"test": "npm run test:e2e",
		"test:e2e": "node --import tsx --test test/e2e.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"files": [
		"src",
		"README.md"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@earendil-works/pi-ai": "{{ pi_version }}",
		"@earendil-works/pi-coding-agent": "{{ pi_version }}",
		"@earendil-works/pi-tui": "{{ pi_version }}",
		"@types/node": "22.20.4",
		"tsx": "4.23.15",
		"typebox": "{{ typebox_version }}",
		"typescript": "7.0.2"
	}
}
