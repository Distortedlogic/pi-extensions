{
	"name": "{{ project_name }}",
	"version": "0.1.0",
	"private": true,
	"description": "{{ project_description }}",
	"type": "module",
	"keywords": [
		"pi-package"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Distortedlogic/{{ project_name }}.git"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"check": "npm run typecheck && npm run lint && npm test",
		"lint": "biome check .",
		"test": "npm run test:e2e",
		"test:e2e": "node --experimental-strip-types --test test/e2e.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"files": [
		"src",
		"README.md"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": ">=0.85.1 <1",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/node": "^22.19.0",
		"minimatch": "^10.2.6",
		"typescript": "~7.0.2",
		"yaml": "^2.9.1"
	}
}
